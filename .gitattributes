
# Snapshot bytes are compared with pinned upstream goldens on Windows too.
snapshots/** -text
apps/web/dist/** -text
dsh/session/bin/icu/** -text
examples/python-web-echo/** text eol=lf
# Evidence hashes must survive checkout on Windows and POSIX.
migration/** text eol=lf
migration/evidence/artifacts/** -text
# Preserve diagnostic whitespace in archived command output.
migration/evidence/artifacts/*.txt -whitespace
# Archived JSON preserves original bytes, including Windows CRLF line endings.
migration/evidence/artifacts/*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
migration/evidence/artifacts/*.zip filter=lfs diff=lfs merge=lfs -text
