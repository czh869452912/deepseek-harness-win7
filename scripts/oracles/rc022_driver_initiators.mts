import {resolve} from 'node:path'
import {pathToFileURL} from 'node:url'
const load=(path:string)=>import(pathToFileURL(resolve(process.argv[2]!,path)).href)
const {Context}=await load('vendor/cordis/src/index.ts'),{default:Store}=await load('packages/core/session/src/index.ts'),{default:Registry}=await load('packages/session/session-projection/src/index.ts'),{default:Agents}=await load('packages/core/agent/src/index.ts'),{default:Loop}=await load('packages/core/agent-loop/src/index.ts'),{default:Prompt}=await load('packages/core/system-prompt/src/index.ts'),{default:Tools}=await load('packages/core/tools/src/index.ts'),Native=await load('packages/core/tool-executor-native/src/index.ts'),{default:Llm,createUserMessage}=await load('packages/llm/llm/src/index.ts'),{MockAdapter,textResponse}=await load('packages/core/agent-loop/tests/mock-adapter.ts'),rows:any[]=[]
const message=(text:string)=>createUserMessage({content:[{type:'text',text}],source:{kind:'user'}})
for(const action of ['overlap','clear','child']){
 const ctx=new Context(),handles:any[]=[],observations:any[]=[],failures:any[]=[],row:any={action},starts:string[]=[],children:any[]=[];let release:any;const both=new Promise(resolve=>{release=resolve})
 class Adapter extends MockAdapter{async *stream(request:any){const agents=ctx.agents,before=agents.requireInitiator(),entry:any={id:before.id};starts.push(before.id);if(action==='overlap'){if(starts.length===2)release();await both}if(action==='clear')entry.cleared=await agents.withoutInitiator(async()=>{await Promise.resolve();return agents.currentInitiator()})===undefined;if(action==='child'&&before.id==='parent'){const handle=await agents.create({sessionId:'child',agentOptions:{provider:'script',model:'model'},setup:(_scope:any,subject:any)=>{row.setupParent=agents.requireInitiator().id;row.setupChild=subject.id}});handles.push(handle);children.push(handle.agent);handle.agent.followup(message('child input'))}await Promise.resolve();entry.after=agents.requireInitiator()===before;observations.push(entry);yield*super.stream(request)}}
 try{
  ctx.on('agent/error',({error}:any)=>{failures.push(String(error))});for(const plugin of [Llm,Store,Registry,Prompt,Tools,Native,Agents])await ctx.plugin(plugin);await ctx.plugin(Loop,{agents:[]});ctx.llm.registerAdapter(['script'],new Adapter(Array.from({length:4},()=>textResponse('done'))));const agents=ctx.agents
