  "package": "@deepseek-ai/dsh-tool-fs",
  "definitions": {
    "local": {
      "name": "apply_patch",
      "description": "Create, update, delete, or move UTF-8 text files with one patch; prefer it over multiple edit calls when a change spans several files or separated regions.",
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Patch text: start with *** Begin Patch and end with *** End Patch. Use *** Add File: path with + lines; *** Update File: path, optionally followed by *** Move to: path, with @@ or @@ context and space-prefixed context, + added, or - removed lines; *** End of File anchors the last hunk to the file end. Use *** Delete File: path to delete. Paths are relative to the Session working directory."
          }
        },
        "required": [
          "input"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string",
            "const": "commit"
          },
          "cancelled": {
            "type": "boolean"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "add",
                    "update",
                    "delete",
                    "move"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "destination": {
                  "type": "string"
                },
                "patchLine": {
                  "type": "integer"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "completed",
                    "failed",
                    "unknown",
                    "skipped"
                  ]
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "hunkLine": {
                  "type": "integer"
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "before": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "after": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "before",
                      "after"
                    ]
                  }
                }
              },
              "required": [
                "index",
                "kind",
                "path",
                "patchLine",
                "status"
              ]
            }
          },
          "affectedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "phase",
          "cancelled",
          "operations",
          "affectedPaths"
        ]
      }
    },
