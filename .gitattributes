
# Snapshot bytes are compared with pinned upstream goldens on Windows too.
snapshots/** -text
apps/web/** -text
apps/cli/package.json -text
vendor/*/package.json -text
vendor/*/LICENSE -text
vendor/ucrt/** -text -diff
packages/*/*/lib/client.js -text
packages/*/*/lib/client.js.map -text
packages/**/lib/typert.host.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
packages/**/package.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
packages/**/cordis.patch.yml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
packages/preset/agent-presets/presets/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
dsh/session/bin/icu/** -text
dsh/session/bin/zstd/** -text
dsh/javascript/bin/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/native/quickjs_worker.c text eol=lf
scripts/native/workflow/** text eol=lf
scripts/build_workflow.mjs text eol=lf
dsh/javascript/workflow/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
dsh/javascript/client-syntax/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Keep the unmodified, licensed embedded parser byte-for-byte.
dsh/javascript/client-syntax/acorn.js -whitespace
dsh/session/resources/sql/** -text
dsh/session/bin/unicode/** -text
dsh/fs/tool_fs_search/bin/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
examples/python-web-echo/** text eol=lf
# Evidence hashes must survive checkout on Windows and POSIX.
migration/** text eol=lf
# Historical Source observations retain their original byte identity.
migration/history/** -text -whitespace
migration/evidence/artifacts/** -text
# Preserve diagnostic whitespace in archived command output.
migration/evidence/artifacts/*.txt -whitespace
# Archived JSON preserves original bytes, including Windows CRLF line endings.
migration/evidence/artifacts/*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
migration/evidence/artifacts/*.zip filter=lfs diff=lfs merge=lfs -text
migration/storage/*.zip -text
dsh/host/browser_compat/url.js -text
dsh/host/browser_compat/url.LICENSE.txt -text
apps/desktop/wire.cjs -text
apps/desktop/locale.cjs -text
apps/desktop/update-coordinator.cjs -text
apps/desktop/renderer/** -text
apps/desktop-host/transport.js -text
dsh/session/bin/x86/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
dsh/subprocess/bin/** -text
# Preserve official x86 notices/provenance verbatim, including source whitespace.
dsh/fs/tool_fs_search/bin/x86/** -whitespace
dsh/javascript/bin/x86/** -whitespace
dsh/session/bin/icu/x86/** -whitespace
dsh/session/bin/zstd/x86/** -whitespace
dsh/subprocess/bin/winpty/x86/** -whitespace
