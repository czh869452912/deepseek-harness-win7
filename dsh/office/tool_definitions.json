[
  {
    "name": "office_render",
    "description": "Render document pages, slides, or worksheet areas as images you can view.",
    "parameters": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "description": "Path to doc, docx, odt, xls, xlsx, ods, ppt, pptx, odp, or pdf; not modified."
        },
        "pages": {
          "type": "array",
          "description": "Distinct one-based pages or slides; omit for all. Spreadsheets use sheet and range instead.",
          "items": {
            "type": "integer"
          }
        },
        "sheet": {
          "type": "string",
          "description": "Exact worksheet name; omit to render every visible sheet."
        },
        "range": {
          "type": "string",
          "description": "A1 range, such as A1:H40; requires sheet. Omit for the used area."
        },
        "dpi": {
          "type": "integer",
          "description": "Resolution from 24 to 600; default 144."
        }
      },
      "required": [
        "input"
      ]
    },
    "output": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "const": "render"
          },
          "path": {
            "type": "string",
            "description": "Canonical absolute input path."
          },
          "pageCount": {
            "type": "integer",
            "description": "Pages or slides of a document, or visible worksheets."
          },
          "dpi": {
            "type": "integer"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": "integer"
                },
                "sheet": {
                  "type": "string"
                },
                "range": {
                  "type": "string"
                },
                "attachmentId": {
                  "type": "string"
                },
                "mediaType": {
                  "type": "string",
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                },
                "bytes": {
                  "type": "integer"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                },
                "originalDimensions": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "width": {
                      "type": "integer"
                    },
                    "height": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ]
                }
              },
              "required": [
                "attachmentId",
                "mediaType",
                "bytes",
                "width",
                "height"
              ]
            }
          },
          "missingFonts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "operation",
          "path",
          "pageCount",
          "dpi",
          "images",
          "missingFonts"
        ]
      }
    }
  },
  {
    "name": "office_convert",
    "description": "Convert a document to another format. Return a temporary file to copy to its destination with the shell.",
    "parameters": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "description": "Path to doc, docx, odt, xls, xlsx, ods, ppt, pptx, or odp; not modified."
        },
        "format": {
          "type": "string",
          "description": "Word: pdf, docx, odt, txt. Excel: pdf, xlsx, ods, csv. PowerPoint: pdf, pptx, odp.",
          "enum": [
            "pdf",
            "docx",
            "odt",
            "txt",
            "xlsx",
            "ods",
            "csv",
            "pptx",
            "odp"
          ]
        },
        "sheet": {
          "type": "string",
          "description": "Exact worksheet name for CSV only; required when the workbook has several sheets."
        }
      },
      "required": [
        "input",
        "format"
      ]
    },
    "output": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "const": "convert"
          },
          "path": {
            "type": "string",
            "description": "Canonical absolute input path."
          },
          "file": {
            "type": "string",
            "description": "Absolute path of the temporary output file."
          },
          "format": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "odt",
              "txt",
              "xlsx",
              "ods",
              "csv",
              "pptx",
              "odp"
            ]
          },
          "bytes": {
            "type": "integer"
          },
          "pageCount": {
            "type": "integer",
            "description": "Page count the converter reports for the output."
          },
          "missingFonts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "operation",
          "path",
          "file",
          "format",
          "bytes",
          "missingFonts"
        ]
      }
    }
  },
  {
    "name": "office_recalculate",
    "description": "Recalculate spreadsheet formulas. Return a temporary workbook to copy to its destination with the shell.",
    "parameters": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "description": "Path to an xls, xlsx, or ods workbook; not modified."
        },
        "format": {
          "type": "string",
          "description": "Output workbook format.",
          "enum": [
            "xlsx",
            "ods"
          ]
        }
      },
      "required": [
        "input",
        "format"
      ]
    },
    "output": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "const": "recalculate"
          },
          "path": {
            "type": "string",
            "description": "Canonical absolute input path."
          },
          "file": {
            "type": "string",
            "description": "Absolute path of the temporary output file."
          },
          "format": {
            "type": "string",
            "enum": [
              "xlsx",
              "ods"
            ]
          },
          "bytes": {
            "type": "integer"
          },
          "pageCount": {
            "type": "integer",
            "description": "Page count the converter reports for the output."
          },
          "missingFonts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "operation",
          "path",
          "file",
          "format",
          "bytes",
          "missingFonts"
        ]
      }
    }
  }
]
