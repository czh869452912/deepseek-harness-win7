          "hidden"
        ]
      }
    ]
  },
  {
    "name": "events-invalid-text",
    "mode": "events-materialize",
    "filters": [
      {
        "kind": "text",
        "text": 42
      }
    ]
  },
  {
    "name": "text-empty",
    "mode": "text",
    "text": "  ",
    "documents": [
      "a"
    ]
  },
  {
    "name": "text-literal",
    "mode": "text",
    "text": " [tag].* ",
    "documents": [
      "[TAG].*",
      "tagAB",
      "[tag].x"
    ]
  },
  {
    "name": "text-whitespace",
    "mode": "text",
    "text": " A B ",
    "documents": [
      "A\tB",
      "AB",
      "A\u001cB",
      "A﻿B"
    ]
  },
  {
    "name": "text-bom-trim",
    "mode": "text",
    "text": "﻿Alpha﻿",
    "documents": [
      "alpha",
      "ALPHA",
      "﻿Alpha﻿"
    ]
  },
  {
    "name": "text-case-i",
    "mode": "text",
    "text": "I",
    "documents": [
      "I",
      "i",
      "İ",
      "ı"
    ]
  },
  {
    "name": "text-case-dotted",
    "mode": "text",
    "text": "İ",
    "documents": [
      "I",
      "i",
      "İ",
      "ı"
    ]
  },
  {
    "name": "text-case-dotless",
    "mode": "text",
    "text": "ı",
    "documents": [
      "I",
      "i",
      "İ",
      "ı"
    ]
  },
  {
    "name": "text-empty-documents",
    "mode": "events-filter",
    "filters": [
      {
        "kind": "text",
        "text": "  "
      }
    ]
  },
  {
    "name": "documents-surface",
    "mode": "documents"
  },
