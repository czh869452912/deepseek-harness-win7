const load=(path:string)=>import(pathToFileURL(resolve(process.argv[2]!,path)).href)
const {ToolCallRecovery,openTurnClosers}=await load('packages/core/session/src/repair.ts'),rows:any[]=[]
for(const {test,events} of JSON.parse(readFileSync(process.argv[3]!,'utf8'))){const recovery=new ToolCallRecovery({kind:test.cause});for(const event of events)recovery.observe(event);const a=recovery.results(),b=recovery.results();rows.push({test,results:a,repeat:JSON.stringify(a)===JSON.stringify(b),closers:openTurnClosers(events,{kind:test.cause})})}
const {Context}=await load('vendor/cordis/src/index.ts'),{default:Store}=await load('packages/core/session/src/index.ts'),{default:Registry}=await load('packages/session/session-projection/src/index.ts'),{default:Agents}=await load('packages/core/agent/src/index.ts'),{default:Loop}=await load('packages/core/agent-loop/src/index.ts'),{default:Prompt}=await load('packages/core/system-prompt/src/index.ts'),{default:Tools}=await load('packages/core/tools/src/index.ts'),{NativeToolExecutor}=await load('packages/core/tool-executor-native/src/index.ts'),{default:Llm,createUserMessage}=await load('packages/llm/llm/src/index.ts'),{MockAdapter}=await load('packages/core/agent-loop/tests/mock-adapter.ts')
for(const action of ['executor-unloaded','write-failure','recovery-failure']){
 const ctx=new Context(),primary=new Error('primary'),secondary=new Error('secondary'),failures:any[]=[],bodies:string[]=[];let handle:any
 try{for(const plugin of [Llm,Store,Registry,Prompt,Tools,Agents])await ctx.plugin(plugin);const dispose=ctx.tools.setExecutor(new NativeToolExecutor(ctx));await ctx.plugin(Loop,{agents:[]});ctx.tools.register({name:'work',description:'',parameters:{},output:{schema:{type:'string'},render:(_:any,value:string)=>[{type:'text',text:value}]},async execute(_:any,execution:any){bodies.push(execution.callId);return 'ok'}});if(action==='executor-unloaded')ctx.on('llm/stream',(_:any,next:any)=>{dispose();return next()});ctx.on('agent/error',(input:any)=>failures.push({primary:input.error===primary,aggregate:(input.error.errors??[]).map((error:any)=>error===primary||error===secondary),cause:input.error.cause===primary}));const chunks:any[]=[];for(let index=0;index<2;index++){const block={type:'tool-call',id:'c'+index,name:'work',arguments:'{}'};chunks.push({type:'block-start',index,blockType:'tool-call'},{type:'tool-call-delta',index,id:block.id,name:'work',argumentsDelta:'{}'},{type:'block-end',index,block})}chunks.push({type:'finish',reason:{kind:'tool-calls'}});ctx.llm.registerAdapter(['script'],new MockAdapter([chunks]));handle=await ctx.agents.create({sessionId:'recover',agentOptions:{provider:'script',model:'model'}});const agent=handle.agent;if(action!=='executor-unloaded'){const append=agent.session.append.bind(agent.session);agent.session.append=(kind:any,data:any,options:any)=>{if(kind==='tool/result'){if(data.error&&action==='recovery-failure')throw secondary;if(!data.error)throw primary}return append(kind,data,options)}}agent.followup(createUserMessage({content:[{type:'text',text:'go'}],source:{kind:'user'}}));await agent.whenIdle();const events=agent.session.snapshotEvents();rows.push({action,bodies,failures,results:events.filter((event:any)=>event.type==='tool/result').map((event:any)=>({callId:event.data.message.toolCallId,code:event.data.error.code,source:event.sourceEventSeqs??null})),tail:events.slice(-2).map((event:any)=>event.type)})}finally{if(handle)await handle.dispose();await ctx.fiber.dispose()}
}
